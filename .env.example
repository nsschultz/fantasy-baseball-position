# Environment Configuration Example

# This file shows all required and optional environment variables for the Position Service.
# Copy to .env and update values for your environment.
#
# IMPORTANT: Never commit actual .env files to git repository
# This .env.example file is safe to commit and serves as documentation

# ============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================================================

# PostgreSQL Host
# - For Docker Compose: use container name (e.g., database)
# - For remote: use full hostname or IP address
POSITION_DATABASE_HOST=database

# PostgreSQL Database Name
# - Must match the database created in PostgreSQL
POSITION_DATABASE=position-db

# PostgreSQL User Account
# - Should have permissions to create tables and indices
# - Never use 'postgres' superuser account in production
POSITION_DATABASE_USER=position_user

# PostgreSQL Password (REQUIRED - Must be set via environment variable)
# - Use strong password in production (minimum 12 characters, mixed case, numbers, symbols)
# - Never commit actual passwords to version control
# - Use secrets management in production environments:
#   * Docker Secrets (Docker Swarm)
#   * Kubernetes Secrets (Kubernetes)
#   * AWS Secrets Manager (AWS)
#   * Azure Key Vault (Azure)
#   * HashiCorp Vault (On-premise)
POSITION_DATABASE_PASSWORD=change_me_in_production

# ============================================================================
# DATABASE CONNECTION SETTINGS (Optional)
# ============================================================================

# Database Port (default: 5432)
# POSITION_DATABASE_PORT=5432

# SSL Mode (default: disable)
# Options: disable, allow, prefer, require
# POSITION_DATABASE_SSL_MODE=disable

# Connection Timeout (default: 10 seconds)
# CONNECTION_TIMEOUT=10

# Command Timeout (default: 30 seconds)
# COMMAND_TIMEOUT=30

# Database Connection Pool Size
# Min connections: 5, Max connections: 20 (recommended: 10)
# DB_CONNECTION_POOL_SIZE=10

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# ASP.NET Core Environment
# - Development: verbose logging, detailed error pages
# - Staging: production-like settings with detailed logging
# - Production: optimized, minimal logging, security hardened
ASPNETCORE_ENVIRONMENT=Production

# URLs for the application
# Default in Docker: http://+:8080
# ASPNETCORE_URLS=http://+:8080

# Graceful Shutdown Timeout (seconds)
# How long to wait for in-flight requests before forceful shutdown
ASPNETCORE_SHUTDOWN_TIMEOUT=30

# ============================================================================
# LOGGING (Optional)
# ============================================================================

# Log Level (default: Information)
# Options: Trace, Debug, Information, Warning, Error, Critical, None
# LOG_LEVEL=Information

# Enable Structured Logging (default: true)
# STRUCTURED_LOGGING=true

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# CORS Origins (comma-separated)
# Allowed origins for Cross-Origin Resource Sharing
# Default: localhost, schultz.local
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# API Key (optional)
# For future API authentication
# API_KEY=your-api-key-here

# ============================================================================
# HEALTH CHECKS
# ============================================================================

# Health Check Interval (seconds)
# How often health checks are performed
HEALTH_CHECK_INTERVAL=30

# Health Check Timeout (seconds)
# Maximum time to wait for health check response
HEALTH_CHECK_TIMEOUT=5

# ============================================================================
# PGADMIN CONFIGURATION (For Development Only)
# ============================================================================

# PgAdmin Email (default: admin@example.com)
PGADMIN_EMAIL=admin@example.com

# PgAdmin Password (REQUIRED for docker-compose development)
# This is only for development environments
# Never use in production - PgAdmin should not be exposed
PGADMIN_PASSWORD=development_password_change_me

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Request Timeout (seconds)
REQUESTS_TIMEOUT=30

# ============================================================================
# MONITORING AND OBSERVABILITY
# ============================================================================

# SonarQube/SonarCloud Token (for code quality)
# Get from: https://sonarcloud.io/account/security
# SONAR_TOKEN=your-sonar-token-here

# Application Insights Key (optional)
# For Azure monitoring
# APPINSIGHTS_INSTRUMENTATIONKEY=your-key-here

# ============================================================================
# DOCKER & DEPLOYMENT
# ============================================================================

# Docker Registry
# DOCKER_REGISTRY=docker.io
# DOCKER_USERNAME=nschultz
# DOCKER_TOKEN=your-registry-token

# Kubernetes (if using K8s deployment)
# KUBERNETES_SERVICE_HOST=kubernetes.default.svc
# KUBERNETES_SERVICE_PORT=443

# ============================================================================
# VERSION INFO (Read-Only)
# ============================================================================

# Application Version (read from version.txt)
# This is read automatically, do not set here
# VERSION=1.2.3

# ============================================================================
# DOCKER COMPOSE RESOURCE LIMITS
# ============================================================================

# CPU Limits (1.0 = 1 CPU core)
# API_CPU_LIMIT=1
# API_CPU_RESERVATION=0.5
# DB_CPU_LIMIT=1
# DB_CPU_RESERVATION=0.5

# Memory Limits (in megabytes)
# API_MEMORY_LIMIT=512
# API_MEMORY_RESERVATION=256
# DB_MEMORY_LIMIT=512
# DB_MEMORY_RESERVATION=256

# ============================================================================
# ENVIRONMENT SETUP EXAMPLES
# ============================================================================

# LOCAL DEVELOPMENT
# ASPNETCORE_ENVIRONMENT=Development
# POSITION_DATABASE_HOST=localhost
# POSITION_DATABASE=position_db_dev
# POSITION_DATABASE_USER=position_dev
# POSITION_DATABASE_PASSWORD=dev_password
# PGADMIN_PASSWORD=dev_pgadmin_password

# CI/CD TESTING
# ASPNETCORE_ENVIRONMENT=Testing
# POSITION_DATABASE_HOST=database
# POSITION_DATABASE=position_test
# POSITION_DATABASE_USER=position_test
# POSITION_DATABASE_PASSWORD=test_password

# PRODUCTION
# ASPNETCORE_ENVIRONMENT=Production
# POSITION_DATABASE_HOST=prod-db-cluster.example.com
# POSITION_DATABASE=position_prod
# POSITION_DATABASE_USER=position_prod
# POSITION_DATABASE_PASSWORD=<use secrets manager>
# PGADMIN_PASSWORD=<disabled - do not expose>

# ============================================================================
# SECURITY BEST PRACTICES
# ============================================================================

# 1. Always use environment variables for secrets
# 2. Never commit .env with real passwords to version control
# 3. Use .env.example for template (this file)
# 4. Use .env for local development
# 5. Use secrets management for production:
#    - Docker Secrets (Docker Swarm)
#    - Kubernetes Secrets (Kubernetes)
#    - AWS Secrets Manager (AWS)
#    - Azure Key Vault (Azure)
#    - HashiCorp Vault (On-premise)

# 6. Rotate passwords regularly
# 7. Use strong passwords (minimum 12 characters)
# 8. Different passwords for different environments
# 9. Store database backups securely
# 10. Audit access to sensitive configurations

# ============================================================================
# NOTES
# ============================================================================

# Connection String Format:
#   Server={POSITION_DATABASE_HOST};Database={POSITION_DATABASE};
#   User Id={POSITION_DATABASE_USER};Password={POSITION_DATABASE_PASSWORD};

# Docker Compose override:
#   - docker-compose.override.yml for local development
#   - Allows customization without modifying base compose file
#   - Add to .gitignore to prevent accidental commits

# For Docker Compose, create .env file and run:
#   docker-compose --env-file .env up -d
