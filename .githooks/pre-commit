#!/bin/bash
# Pre-commit hooks for fantasy-baseball-position
# 
# Install with: cp .githooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or configure git: git config core.hooksPath .githooks

set -e

echo "🔍 Running pre-commit checks..."

# Check for staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cs)$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo "✅ No C# files staged for commit"
    exit 0
fi

echo "📝 Staged files:"
echo "$STAGED_FILES" | sed 's/^/  /'

# 1. Check for secrets
echo ""
echo "🔒 Checking for secrets..."
if git diff --cached | grep -E '(password|token|secret|api[_-]?key|auth)\s*[=:]' | grep -v '^[[:space:]]*//'; then
    echo "❌ Potential secrets found in staged changes!"
    echo "   Please remove any secrets before committing"
    exit 1
fi
echo "✅ No secrets detected"

# 2. Run dotnet format check
echo ""
echo "🎨 Checking code formatting..."
if ! dotnet format --verify-no-changes --include "$STAGED_FILES" > /dev/null 2>&1; then
    echo "⚠️  Code formatting issues found"
    echo "   Running: dotnet format --include '$STAGED_FILES'"
    dotnet format --include "$STAGED_FILES"
    echo "   ℹ️  Files have been formatted. Please stage them again and retry commit:"
    echo "   git add $STAGED_FILES"
    exit 1
fi
echo "✅ Code formatting OK"

# 3. Check for large files
echo ""
echo "📦 Checking file sizes..."
MAX_SIZE=$((5 * 1024 * 1024))  # 5MB
for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        SIZE=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null)
        if [ "$SIZE" -gt "$MAX_SIZE" ]; then
            echo "❌ File too large: $file ($(($SIZE / 1024 / 1024))MB)"
            exit 1
        fi
    fi
done
echo "✅ File sizes OK"

# 4. Optional: Run local build check (commented out for speed)
# Uncomment to enable - this will make commits slower but more reliable
# echo ""
# echo "🔨 Running local build check..."
# if ! dotnet build > /dev/null 2>&1; then
#     echo "❌ Build failed! Fix errors before committing"
#     dotnet build
#     exit 1
# fi
# echo "✅ Build OK"

# 5. Optional: Run tests (commented out for speed)
# Uncomment to enable - this will make commits slower but ensure quality
# echo ""
# echo "✅ Running tests..."
# if ! dotnet test > /dev/null 2>&1; then
#     echo "❌ Tests failed! Fix tests before committing"
#     dotnet test
#     exit 1
# fi
# echo "✅ Tests OK"

echo ""
echo "✅ All pre-commit checks passed!"
echo "   Proceeding with commit..."
exit 0
